{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudiraStudioMusic",
  "version": "2.0.0",
  "identifier": "com.audira.studiomusic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AudioMix Studio",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/app"
    ],
    "resources": [
      "binaries/app-x86_64-pc-windows-msvc.exe"
    ],
    "windows": {
      "nsis": {}
    }
  }
}
